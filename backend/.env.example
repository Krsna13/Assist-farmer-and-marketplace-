# =============================================================================
# SMART AGRICULTURE MANAGEMENT - BACKEND ENVIRONMENT VARIABLES
# =============================================================================

# Server Configuration
PORT=5000

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Marketplace Auto-Sync (owner-only automatic publishing)
# Set this to one email address to enable auto-publish for that account only.
# Leave blank to disable auto-sync for all accounts (everyone uses manual publish).
# This is checked server-side against the stored User document — not trusted from JWT.
MARKETPLACE_AUTO_PUBLISH_EMAIL=

# Database (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/farm_management

# Image Storage Provider
# Options: 'cloudinary' (production) or 'local' / 'mock' (development/testing)
STORAGE_PROVIDER=local

# Cloudinary Storage Credentials (required if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Integrations
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_email_app_password
# GOOGLE_API_KEY=your_gemini_api_key
